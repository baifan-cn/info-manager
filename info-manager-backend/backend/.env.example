# 后端环境变量配置

# PostgreSQL 数据库
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app

# 安全配置
# 使用以下命令生成: openssl rand -hex 32
SECRET_KEY=changethis123changethis123changethis123changethis123changethis123

# 超级用户
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# 项目配置
PROJECT_NAME=Info Manager
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_V1_STR=/api/v1

# 邮件配置 (可选)
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=Info Manager

# Sentry (可选)
SENTRY_DSN=

# 环境
ENVIRONMENT=local
